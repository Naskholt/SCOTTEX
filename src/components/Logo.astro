---
// Benjamin's stitched SCOTTEX logo. Drop it in public/images as logo.svg (best) or logo.png
// (white on transparent). Until a file exists, the text wordmark is shown instead.
import fs from 'node:fs';
import path from 'node:path';
// `text` = font size of the fallback wordmark, `img` = height of the logo image (it is a wide, tall mark).
interface Props { class?: string; text: string; img: string; eager?: boolean }
const { class: cls = '', text, img, eager = false } = Astro.props;
const file = ['logo.svg', 'scottex-logo-white.svg', 'logo.png', 'logo.webp'].find((f) =>
  fs.existsSync(path.join(process.cwd(), 'public/images', f)),
);
---
{file ? (
  <img src={`/images/${file}`} alt="Scottex" class={`block w-auto ${cls}`} style={`height:${img}`}
    loading={eager ? 'eager' : 'lazy'} decoding="async" />
) : (
  <span class={`display block leading-none ${cls}`} style={`font-size:${text}`}>Scottex</span>
)}

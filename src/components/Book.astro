---
// One way to book: a fitting at the studio, through one Cal.com event (see `booking` in src/data/site.ts).
import Stitch from './Stitch.astro';
import { site, booking } from '../data/site';
const fallback = site.instagram || (site.email ? `mailto:${site.email}` : '');
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="book" class="relative overflow-hidden bg-coal py-[clamp(104px,14vw,200px)]" aria-labelledby="book-title">
  <Stitch class="pointer-events-none absolute -right-24 top-16 w-[min(720px,110vw)] opacity-30" variant="loops" />
  <div class="wrap relative">
    <p class="label mb-10 text-ash">04 — Book</p>
    <h2 id="book-title" class="display max-w-[14ch] text-[clamp(40px,7vw,112px)]" data-reveal>Made for one body. Yours.</h2>
    <p class="mt-8 max-w-[46ch]" data-reveal>
      It starts with a fitting in my studio. Booking takes three steps.
    </p>

    <ol class="mt-16 grid border-t border-bone/15 md:grid-cols-3">
      {booking.steps.map((s, i) => (
        <li class="border-b border-bone/15 py-8 md:border-b-0 md:pr-10" data-reveal>
          <p class="label text-ash">[ {pad(i + 1)} ]</p>
          <h3 class="display mt-4 text-[clamp(20px,2vw,28px)]">{s.t}</h3>
          <p class="mt-3 max-w-[32ch] text-bone/85">{s.d}</p>
        </li>
      ))}
    </ol>

    <div class="mt-12 flex flex-col gap-4 md:mt-16 md:flex-row md:items-center md:gap-8" data-reveal>
      {booking.calLink ? (
        <button type="button" class="btn btn-rivet w-full justify-between md:w-[340px]"
          data-cal-link={booking.calLink} data-cal-namespace={booking.id}
          data-cal-config='{"theme":"dark","layout":"month_view"}'>
          Book a fitting <span aria-hidden="true">[ → ]</span>
        </button>
      ) : fallback ? (
        <a href={fallback} class="btn btn-rivet w-full justify-between md:w-[340px]">
          Book a fitting <span aria-hidden="true">[ → ]</span>
        </a>
      ) : (
        <span class="btn w-full cursor-default opacity-50 md:w-[340px]" aria-disabled="true">Booking opens soon</span>
      )}
      <p class="label text-ash">{booking.length} · {booking.where} · {site.deposit} deposit, fully refundable</p>
    </div>

    <div class="mt-20 grid gap-8 border-t border-bone/15 pt-10 md:grid-cols-3" data-reveal>
      <div><p class="label text-ash">Studio</p><p class="mt-2">{site.address}<br />{site.city}</p></div>
      <div><p class="label text-ash">Entrance</p><p class="mt-2">{site.entrance}</p></div>
      <div><p class="label text-ash">Hours</p><p class="mt-2">{site.hours}</p></div>
    </div>
  </div>
</section>

{booking.calLink && (
  <script is:inline data-cal-id={booking.id}>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    const id = document.currentScript.dataset.calId;
    Cal("init", id, { origin: "https://cal.com" });
    Cal.ns[id]("ui", { theme: "dark", cssVarsPerTheme: { dark: { "cal-brand": "#B4733A" } }, hideEventTypeDetails: false, layout: "month_view" });
  </script>
)}

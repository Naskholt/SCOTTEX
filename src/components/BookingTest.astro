---
// Booking TEST (fake-door) — on the home page. Opens from any [data-book-start] link (the "Start your pair" buttons).
// Steps: find a time → tell me about you → confirm (250 kr) → honest reveal. Nothing is booked or paid.
// Recording: anonymous step events go to a Google Sheet (bookingTest.sheetUrl). Name + email are only sent
// if the visitor presses "Keep my answer" on the reveal. Sheet setup: tools/booking-test/README.md
import { site, booking, bookingTest as T } from '../data/site';
const where = site.address.replace(', st.', '');
const entrance = site.entrance.charAt(0).toLowerCase() + site.entrance.slice(1);
---
<div id="bt" class="bt fixed inset-0 z-[80] hidden flex-col bg-void" role="dialog" aria-modal="true" aria-labelledby="bt-title"
  data-sheet={T.sheetUrl} data-times={JSON.stringify(T.times)}>

  <!-- Top bar -->
  <div class="wrap flex h-16 shrink-0 items-center justify-between md:h-20">
    <p class="label hidden w-40 text-ash sm:block">Start your pair</p>
    <p class="label text-ash" aria-live="polite" data-bt-counter>[ <span data-bt-now>01</span> / 03 ]</p>
    <button type="button" class="label flex min-h-11 items-center justify-end pl-4 text-white sm:w-40" data-bt-close>Close [ × ]</button>
  </div>
  <!-- Progress: a stitched thread that sews itself across -->
  <div class="relative h-px shrink-0 bg-bone/10" aria-hidden="true">
    <div class="bt-thread absolute left-0 top-[-1px] h-0 border-t-[1.5px] border-dashed border-thread" data-bt-thread></div>
  </div>

  <div class="bt-scroll flex-1 overflow-y-auto overscroll-contain" data-lenis-prevent>
    <form class="wrap py-10 md:py-16" novalidate data-bt-form>

      <!-- 01 · Time -->
      <section class="bt-step grid gap-10 md:grid-cols-12 md:gap-6" data-bt-step="time">
        <div class="md:col-span-5">
          <p class="label text-ash">01 - Time</p>
          <h2 id="bt-title" class="display mt-6 text-[clamp(34px,5vw,72px)]">Find a time</h2>
          <p class="mt-6 max-w-[30ch] font-serif text-[clamp(20px,1.8vw,24px)] leading-snug text-bone/85">
            A fitting in my studio takes about half an hour. Pick what suits you.
          </p>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <p class="label text-ash">Day</p>
          <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-8" data-bt-days role="group" aria-label="Day"></div>
          <p class="label mt-10 text-ash">Time</p>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4" data-bt-timegrid role="group" aria-label="Time">
            {T.times.map((t) => <button type="button" class="bt-pick label h-12" aria-pressed="false" data-bt-time={t}>{t}</button>)}
          </div>
          <p class="bt-err label mt-6 text-rivet" role="alert" data-bt-err="time"></p>
          <div class="mt-10 flex justify-end">
            <button type="button" class="btn btn-rivet w-full justify-between sm:w-[300px]" data-bt-next="about">Next <span aria-hidden="true">[ → ]</span></button>
          </div>
        </div>
      </section>

      <!-- 02 · About you -->
      <section hidden class="bt-step grid gap-10 md:grid-cols-12 md:gap-6" data-bt-step="about">
        <div class="md:col-span-5">
          <p class="label text-ash">02 - About you</p>
          <h2 class="display mt-6 text-[clamp(34px,5vw,72px)]">Tell me about you</h2>
          <p class="mt-6 max-w-[30ch] font-serif text-[clamp(20px,1.8vw,24px)] leading-snug text-bone/85">
            So I know what you're after before we meet.
          </p>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <fieldset>
            <legend class="label text-ash">What would you like made? <span class="text-ash/70">· pick any</span></legend>
            <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
              {T.pieces.map((p) => (
                <button type="button" class="bt-pick bt-check label h-12 justify-start px-4" aria-pressed="false" data-bt-piece={p}>
                  <span class="bt-box" aria-hidden="true"></span>{p}
                </button>
              ))}
            </div>
          </fieldset>
          <label class="mt-10 block">
            <span class="label text-ash">Tell me what you're looking for <span class="text-ash/70">· optional</span></span>
            <textarea class="bt-in bt-area" rows="3" maxlength="500" data-bt-note
              placeholder="E.g. wide raw-denim jeans with embroidery on the back pockets"></textarea>
          </label>
          <fieldset class="mt-10">
            <legend class="label text-ash">What matters most to you? <span class="text-ash/70">· pick any</span></legend>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {T.matters.map((m) => (
                <button type="button" class="bt-pick bt-check label h-12 justify-start px-4" aria-pressed="false" data-bt-matter={m}>
                  <span class="bt-box" aria-hidden="true"></span>{m}
                </button>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-10">
            <legend class="label text-ash">What would you spend?</legend>
            <div class="mt-3 grid grid-cols-2 gap-2">
              {T.budget.map((b) => <button type="button" class="bt-pick label h-12" aria-pressed="false" data-bt-budget={b}>{b}</button>)}
            </div>
          </fieldset>
          <div class="mt-10 grid gap-8 sm:grid-cols-2">
            <label class="block">
              <span class="label text-ash">Name</span>
              <input class="bt-in" name="name" autocomplete="name" placeholder="Your name" data-bt-name />
            </label>
            <label class="block">
              <span class="label text-ash">Email</span>
              <input class="bt-in" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@mail.com" data-bt-email />
            </label>
          </div>
          <p class="bt-err label mt-6 text-rivet" role="alert" data-bt-err="about"></p>
          <div class="mt-10 flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
            <button type="button" class="label min-h-11 text-left text-white" data-bt-back="time">[ ← ] Back</button>
            <button type="button" class="btn btn-rivet w-full justify-between sm:w-[300px]" data-bt-next="confirm">Next <span aria-hidden="true">[ → ]</span></button>
          </div>
        </div>
      </section>

      <!-- 03 · Confirm -->
      <section hidden class="bt-step grid gap-10 md:grid-cols-12 md:gap-6" data-bt-step="confirm">
        <div class="md:col-span-5">
          <p class="label text-ash">03 - Confirm</p>
          <h2 class="display mt-6 text-[clamp(34px,5vw,72px)]">Confirm</h2>
          <p class="mt-6 max-w-[30ch] font-serif text-[clamp(20px,1.8vw,24px)] leading-snug text-bone/85">
            Check the details. The deposit holds your time.
          </p>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <dl class="border-t border-bone/15">
            <div class="bt-row"><dt class="label text-ash">Fitting</dt><dd>{booking.length} in the studio</dd></div>
            <div class="bt-row"><dt class="label text-ash">Where</dt><dd>{where} · {entrance}</dd></div>
            <div class="bt-row"><dt class="label text-ash">When</dt><dd data-bt-sum="when"></dd></div>
            <div class="bt-row"><dt class="label text-ash">Made</dt><dd data-bt-sum="made"></dd></div>
            <div class="bt-row"><dt class="label text-ash">You</dt><dd data-bt-sum="you"></dd></div>
          </dl>
          <div class="mt-10 flex items-end justify-between border border-rivet/60 p-6">
            <div>
              <p class="label text-ash">Deposit</p>
              <p class="mt-2 text-bone/85">Taken off the final price.<br />Fully refundable.</p>
            </div>
            <p class="display text-[clamp(32px,4vw,48px)]">{site.deposit}</p>
          </div>
          <div class="mt-10 flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex gap-6">
              <button type="button" class="label min-h-11 text-white" data-bt-back="about">[ ← ] Back</button>
              <button type="button" class="label min-h-11 text-ash hover:text-white" data-bt-later>Not now</button>
            </div>
            <button type="button" class="btn btn-rivet w-full justify-between sm:w-[300px]" data-bt-pay>Pay {site.deposit} deposit <span aria-hidden="true">[ → ]</span></button>
          </div>
        </div>
      </section>

      <!-- Reveal (after "Pay") -->
      <section hidden class="bt-step grid gap-10 md:grid-cols-12 md:gap-6" data-bt-step="reveal">
        <div class="md:col-span-6">
          <p class="label text-ash">A note from students at {T.school}</p>
          <h2 class="mt-6 font-serif text-[clamp(34px,4.6vw,64px)] leading-[1.02]">Thank you. Nothing was booked, and nothing was paid.</h2>
        </div>
        <div class="md:col-span-5 md:col-start-8">
          <p class="text-bone/85">
            This booking page is a test by students from {T.school}, made together with Scottex.
            We want to find out if people would book a fitting with a deposit. Your click tells us you would.
          </p>
          {site.instagram && (
            <p class="mt-6 text-bone">
              Want to book a real fitting? Write to Benjamin on Instagram,{' '}<a class="whitespace-nowrap text-white underline underline-offset-4 hover:text-rivet" href={site.instagram} target="_blank" rel="noopener">@{site.instagram.replace(/\/$/, '').split('/').pop()}</a>.
            </p>
          )}
          <p class="label mt-10 text-ash">Can we keep your answer?</p>
          <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8" data-bt-choice>
            <button type="button" class="btn btn-rivet w-full justify-between sm:w-[260px]" data-bt-keep>Keep my answer <span aria-hidden="true">[ → ]</span></button>
            <button type="button" class="label min-h-11 text-left text-white underline underline-offset-4" data-bt-delete>Delete my details</button>
          </div>
          <p class="mt-6 hidden text-bone/85" aria-live="polite" data-bt-choice-done></p>
          <div class="mt-12 flex flex-col gap-4 border-t border-bone/15 pt-8">
            {site.instagram && <a class="label text-white hover:text-rivet" href={site.instagram} target="_blank" rel="noopener">Book a real fitting on Instagram [ → ]</a>}
            <button type="button" class="label min-h-11 text-left text-ash hover:text-white" data-bt-close>Back to the site</button>
          </div>
          <details class="bt-privacy mt-8">
            <summary class="label cursor-pointer text-ash hover:text-white">How we handle your data</summary>
            <div class="mt-4 space-y-3 text-[15px] text-bone/80">
              <p><b>Who:</b> students from {T.school}, testing interest in booking a fitting with Scottex as part of a school project.</p>
              <p><b>What:</b> anonymous steps (which step was reached, the day and time picked, your answers (what you'd like made, what you wrote about it, what matters and your budget), if you came from a shared link, phone or computer). Your name and email only if you press "Keep my answer".</p>
              <p><b>Why:</b> only for the project. Not for marketing, and not shared with anyone else.</p>
              <p><b>Where:</b> in a Google Sheet (Google). No cookies, and nothing is stored on your device.</p>
              <p><b>How long:</b> until the project ends, then it is deleted.</p>
              {T.contact && <p><b>Questions or deletion:</b> <a class="underline" href={`mailto:${T.contact}`}>{T.contact}</a></p>}
            </div>
          </details>
        </div>
      </section>

      <!-- Not now -->
      <section hidden class="bt-step grid gap-10 md:grid-cols-12 md:gap-6" data-bt-step="later">
        <div class="md:col-span-6">
          <p class="label text-ash">No problem</p>
          <h2 class="mt-6 font-serif text-[clamp(34px,4.6vw,64px)] leading-[1.02]">Maybe another time.</h2>
        </div>
        <div class="md:col-span-5 md:col-start-8">
          <p class="text-bone/85">
            Nothing was booked or paid. This page is a test by students from {T.school}, made together with Scottex.
            Can we ask what stopped you?
          </p>
          <div class="mt-6 grid gap-2" role="group" aria-label="What stopped you?">
            {T.stoppedBy.map((r) => <button type="button" class="bt-pick label h-12 justify-start px-4" aria-pressed="false" data-bt-reason={r}>{r}</button>)}
          </div>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
            <button type="button" class="btn btn-rivet w-full justify-between sm:w-[220px]" data-bt-send-reason>Send <span aria-hidden="true">[ → ]</span></button>
            <button type="button" class="label min-h-11 text-left text-ash hover:text-white" data-bt-close>Skip</button>
          </div>
          <p class="mt-6 hidden text-bone/85" aria-live="polite" data-bt-reason-done>Thank you, that helps.</p>
        </div>
      </section>
    </form>
  </div>

  <!-- Before you go: shown when someone closes before confirming -->
  <div class="bt-exit absolute inset-0 z-10 hidden items-end justify-center bg-void/75 sm:items-center" data-bt-exit
    role="alertdialog" aria-modal="true" aria-labelledby="bt-exit-title" aria-describedby="bt-exit-text">
    <div class="w-full max-w-[540px] border-t border-bone/15 bg-coal p-6 sm:border sm:p-10">
      <p class="label text-ash">Before you go</p>
      <h3 id="bt-exit-title" class="display mt-4 text-[clamp(26px,3vw,40px)]">Leaving already?</h3>
      <p id="bt-exit-text" class="mt-4 text-bone/85">Your time isn't held yet, and you're nearly there. What's stopping you?</p>
      <div class="mt-6 grid gap-2" role="group" aria-label="What's stopping you?">
        {T.exitReasons.map((r) => <button type="button" class="bt-pick label h-11 justify-start px-4" aria-pressed="false" data-bt-exit-reason={r}>{r}</button>)}
      </div>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <button type="button" class="btn btn-rivet w-full justify-between sm:w-[280px]" data-bt-exit-continue>Continue booking <span aria-hidden="true">[ → ]</span></button>
        <button type="button" class="label min-h-11 text-left text-ash hover:text-white" data-bt-exit-leave>Leave anyway</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Global (not scoped) so the day buttons created by the script get them too. All prefixed bt-. */
  .bt:not(.hidden) { display: flex; }
  .bt-exit:not(.hidden) { display: flex; }
  .bt-exit > div { animation: bt-in 600ms var(--ease-out-expo); }
  .bt-thread { width: 0; transition: width 900ms var(--ease-out-expo); }
  .bt-pick {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    border: 1px solid rgb(232 227 216 / 0.22); color: var(--color-bone);
    transition: border-color 200ms ease, background 200ms ease, color 200ms ease;
  }
  .bt-pick:hover { border-color: rgb(232 227 216 / 0.6); }
  .bt-pick[aria-pressed='true'] { border-color: var(--color-rivet); background: rgb(180 115 58 / 0.14); color: #fff; }
  .bt-pick:disabled { opacity: 0.3; cursor: default; }
  .bt-box { width: 12px; height: 12px; border: 1px solid currentColor; flex: none; }
  .bt-check[aria-pressed='true'] .bt-box { background: var(--color-rivet); border-color: var(--color-rivet); }
  .bt-in {
    display: block; width: 100%; height: 48px; margin-top: 6px; background: transparent;
    border-bottom: 1px solid rgb(232 227 216 / 0.3); font-size: 18px; color: #fff;
  }
  .bt-in::placeholder { color: var(--color-ash); }
  .bt-area { height: auto; min-height: 96px; padding: 10px 0; line-height: 1.5; resize: vertical; font-size: 17px; }
  .bt-in:focus { outline: none; border-color: var(--color-bone); }
  .bt-row { display: grid; grid-template-columns: 7rem 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgb(232 227 216 / 0.15); align-items: baseline; }
  .bt-step { animation: bt-in 700ms var(--ease-out-expo); }
  @keyframes bt-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .bt-thread { transition: none; }
    .bt-step, .bt-exit > div { animation: none; }
  }
</style>

<script>
  const root = document.getElementById('bt')!;
  const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const $$ = <E extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<E>(s));
  const SHEET = root.dataset.sheet || '';
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const STEPS = ['time', 'about', 'confirm'];

  // One random id per page visit, kept in memory only (no cookies, nothing stored on the device).
  const visitor = Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
  (window as any).scottexVisitor = visitor; // so the hero's newsletter sign-up shares the same id
  const qs = new URLSearchParams(location.search);
  // Don't record local copies, or automated browsers (Netlify's deploy screenshots, crawlers, audits),
  // which load the live site right after every deploy.
  const LOCAL = /^(localhost|127\.|0\.0\.0\.0|\[::1\]|.*\.local$)/.test(location.hostname)
    || navigator.webdriver || /HeadlessChrome|bot|crawl|spider|Lighthouse|PageSpeed|Prerender/i.test(navigator.userAgent);
  const state = { day: '', dayLabel: '', time: '', pieces: [] as string[], note: '', matters: [] as string[], budget: '', name: '', email: '', reason: '' };

  function record(event: string, extra: Record<string, string> = {}) {
    const data = {
      event, visitor,
      day: state.day, time: state.time, pieces: state.pieces.join(', '), note: state.note, matters: state.matters.join(', '), budget: state.budget,
      utm_source: qs.get('utm_source') || '', utm_medium: qs.get('utm_medium') || '', utm_campaign: qs.get('utm_campaign') || '',
      referrer: document.referrer || '', device: innerWidth < 768 ? 'phone' : 'computer',
      ...extra,
    };
    // Only the live site records. Local copies (npm run dev / preview) just log, so testing doesn't fill the sheet.
    if (!SHEET || LOCAL) { console.info('[booking test]', data); return; }
    const body = JSON.stringify(data);
    try { if (navigator.sendBeacon(SHEET, new Blob([body], { type: 'text/plain;charset=utf-8' }))) return; } catch {}
    fetch(SHEET, { method: 'POST', mode: 'no-cors', keepalive: true, headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body }).catch(() => {});
  }

  // ---------- open / close ----------
  let lastFocus: HTMLElement | null = null;
  function open() {
    lastFocus = document.activeElement as HTMLElement;
    root.classList.remove('hidden');
    document.documentElement.style.overflow = 'hidden';
    window.dispatchEvent(new CustomEvent('scottex:lock'));
    $('[data-bt-choice]').hidden = false;
    $('[data-bt-choice-done]').classList.add('hidden');
    $('[data-bt-reason-done]').classList.add('hidden');
    show('time');
    record('open');
    requestAnimationFrame(() => $('[data-bt-close]').focus());
  }
  function close() {
    root.classList.add('hidden');
    document.documentElement.style.overflow = '';
    window.dispatchEvent(new CustomEvent('scottex:unlock'));
    record('close', { step: current });
    lastFocus?.focus();
  }
  document.querySelectorAll<HTMLElement>('[data-book-start]').forEach((a) =>
    a.addEventListener('click', (e) => { e.preventDefault(); open(); }));
  // ---------- before you go ----------
  const exit = $('[data-bt-exit]');
  let exitReason = '';
  const exitOpen = () => !exit.classList.contains('hidden');
  function requestClose() {
    if (!['time', 'about', 'confirm'].includes(current)) return close();
    exitReason = '';
    $$('[data-bt-exit-reason]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    exit.classList.remove('hidden');
    record('exit_prompt', { step: current });
    requestAnimationFrame(() => $('[data-bt-exit-continue]').focus());
  }
  function stay() {
    exit.classList.add('hidden');
    record('exit_continue', { step: current, reason: exitReason });
    $('[data-bt-close]').focus();
  }
  $$('[data-bt-exit-reason]').forEach((b) => b.addEventListener('click', () => {
    $$('[data-bt-exit-reason]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    exitReason = b.dataset.btExitReason!;
  }));
  $('[data-bt-exit-continue]').addEventListener('click', stay);
  $('[data-bt-exit-leave]').addEventListener('click', () => {
    record('exit_leave', { step: current, reason: exitReason });
    exit.classList.add('hidden');
    close();
  });

  $$('[data-bt-close]').forEach((b) => b.addEventListener('click', requestClose));
  document.addEventListener('keydown', (e) => {
    if (root.classList.contains('hidden')) return;
    if (e.key === 'Escape') { if (exitOpen()) stay(); else requestClose(); }
    if (e.key === 'Tab') { // keep focus inside the panel (or the pop-up, when it is open)
      const scope = exitOpen() ? exit : root;
      const f = Array.from(scope.querySelectorAll<HTMLElement>('button:not([disabled]), input, textarea, a[href], summary')).filter((el) => el.offsetParent !== null);
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // ---------- steps ----------
  let current = 'time';
  function show(step: string) {
    current = step;
    $$('[data-bt-step]').forEach((s) => (s.hidden = s.dataset.btStep !== step));
    const i = STEPS.indexOf(step);
    const n = i === -1 ? 3 : i + 1;
    $('[data-bt-now]').textContent = String(n).padStart(2, '0');
    $('[data-bt-counter]').style.visibility = i === -1 ? 'hidden' : 'visible';
    $('[data-bt-thread]').style.width = `${(n / 3) * 100}%`;
    $('.bt-scroll').scrollTop = 0;
    if (step === 'confirm') {
      $('[data-bt-sum="when"]').textContent = `${state.dayLabel} at ${state.time}`;
      $('[data-bt-sum="you"]').textContent = `${state.name} · ${state.email}`;
      $('[data-bt-sum="made"]').textContent = state.pieces.join(', ') + (state.note ? ` · "${state.note}"` : '');
    }
  }
  const err = (k: string, msg: string) => { $(`[data-bt-err="${k}"]`).textContent = msg; };

  $$('[data-bt-next]').forEach((b) => b.addEventListener('click', () => {
    const to = b.dataset.btNext!;
    if (to === 'about') {
      if (!state.day || !state.time) return err('time', 'Pick a day and a time.');
      err('time', ''); record('time_picked');
    }
    if (to === 'confirm') {
      state.name = $<HTMLInputElement>('[data-bt-name]').value.trim();
      state.email = $<HTMLInputElement>('[data-bt-email]').value.trim();
      state.note = $<HTMLTextAreaElement>('[data-bt-note]').value.trim();
      if (!state.pieces.length) return err('about', 'Pick what you would like made.');
      if (!state.matters.length || !state.budget) return err('about', 'Pick what matters to you and a budget.');
      if (!state.name) return err('about', 'Write your name.');
      if (!EMAIL.test(state.email)) return err('about', 'Write a full email, like name@mail.com.');
      err('about', ''); record('details_done'); // anonymous: answers only, no name or email
    }
    show(to);
  }));
  $$('[data-bt-back]').forEach((b) => b.addEventListener('click', () => show(b.dataset.btBack!)));

  // ---------- day + time ----------
  const days = $('[data-bt-days]');
  const d = new Date();
  let added = 0;
  while (added < 8) {
    d.setDate(d.getDate() + 1);
    if (d.getDay() === 0 || d.getDay() === 6) continue; // weekdays only (studio hours)
    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const wd = d.toLocaleDateString('en-GB', { weekday: 'short' });
    const mo = d.toLocaleDateString('en-GB', { month: 'short' });
    const long = d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'bt-pick flex-col !gap-1 py-3';
    b.setAttribute('aria-pressed', 'false');
    b.setAttribute('aria-label', long);
    b.innerHTML = `<span class="label text-ash">${wd}</span><span class="display text-[22px]">${d.getDate()}</span><span class="label text-ash">${mo}</span>`;
    b.addEventListener('click', () => {
      days.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      state.day = iso; state.dayLabel = long; err('time', '');
    });
    days.appendChild(b);
    added++;
  }
  const single = (sel: string, set: (v: string) => void, attr: string) =>
    $$(sel).forEach((b) => b.addEventListener('click', () => {
      $$(sel).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      set(b.getAttribute(attr)!);
    }));
  single('[data-bt-time]', (v) => { state.time = v; err('time', ''); }, 'data-bt-time');
  single('[data-bt-budget]', (v) => (state.budget = v), 'data-bt-budget');
  single('[data-bt-reason]', (v) => (state.reason = v), 'data-bt-reason');
  $$('[data-bt-piece]').forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on));
    const v = b.dataset.btPiece!;
    state.pieces = on ? [...state.pieces, v] : state.pieces.filter((p) => p !== v);
  }));
  $$('[data-bt-matter]').forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on));
    const v = b.dataset.btMatter!;
    state.matters = on ? [...state.matters, v] : state.matters.filter((m) => m !== v);
  }));

  // ---------- pay → reveal, not now → later ----------
  $('[data-bt-pay]').addEventListener('click', () => { record('pay_click'); show('reveal'); });
  $('[data-bt-later]').addEventListener('click', () => { record('not_now'); show('later'); });

  const choiceDone = (msg: string) => {
    $('[data-bt-choice]').hidden = true;
    const p = $('[data-bt-choice-done]'); p.textContent = msg; p.classList.remove('hidden');
  };
  $('[data-bt-keep]').addEventListener('click', () => {
    record('keep', { name: state.name, email: state.email }); // the only event with name + email
    choiceDone('Saved. Thank you for helping us.');
  });
  $('[data-bt-delete]').addEventListener('click', () => {
    record('declined'); // no personal details are ever sent on this path
    state.name = ''; state.email = '';
    $<HTMLInputElement>('[data-bt-name]').value = ''; $<HTMLInputElement>('[data-bt-email]').value = '';
    choiceDone('Done. Your name and email were never sent, and are now cleared from this page.');
  });
  $('[data-bt-send-reason]').addEventListener('click', () => {
    if (!state.reason) return;
    record('reason', { reason: state.reason });
    $('[data-bt-reason-done]').classList.remove('hidden');
  });

  // A visit only counts after real input from a person: a touch, the mouse wheel, a click or a key.
  // Not 'scroll': screenshot bots scroll the page themselves after every deploy. Only trusted
  // events (made by the user, not by a script) count.
  {
    const evs = ['wheel', 'touchstart', 'pointerdown', 'keydown'] as const;
    const once = (e: Event) => {
      if (!e.isTrusted) return;
      evs.forEach((n) => removeEventListener(n, once, true));
      record('view');
    };
    evs.forEach((e) => addEventListener(e, once, { capture: true, passive: true }));
  }
</script>

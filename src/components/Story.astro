---
import Stitch from './Stitch.astro';
import { site } from '../data/site';
---
<section id="story" class="relative py-[clamp(104px,16vw,220px)]">
  <div class="wrap">
    <p class="label mb-10 text-ash" data-reveal>01 — Story</p>
    <div class="grid gap-y-16 md:grid-cols-12 md:gap-x-6">
      <div class="md:col-span-7">
        <h2 class="display text-[clamp(40px,7vw,112px)]" data-reveal>One maker.<br />One body.<br />One pair.</h2>
        <Stitch class="mt-10 w-[min(520px,90%)]" variant="loops" />
      </div>
      <div class="flex flex-col gap-6 md:col-span-4 md:col-start-9 md:pt-24">
        <p data-reveal>
          I'm {site.maker}. Scottex is my jeans label. Since {site.since} I've cut, sewn and finished every pair myself, in my studio on Nørrebrogade. You come in through the shop SABOT.
        </p>
        <p data-reveal>
          Every pair is drafted for one body. I work with deadstock denim from Japan and Italy, cloth left over from other companies, so some fabrics only ever become a few pairs.
        </p>
        <p data-reveal>
          Somewhere between dark Scandinavian myth and American workwear. Heavy cloth, copper thread, and my freehand embroidery on the back pockets. It's never the same twice.
        </p>
      </div>
    </div>


  </div>
</section>

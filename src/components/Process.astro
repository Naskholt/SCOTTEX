---
// Overview with visuals: pick a step, the photo changes. Steps advance on their own while in view
// (see "Process stepper" in src/scripts/motion.ts).
const steps = [
  { t: 'Talk', d: 'You come by the studio. We talk fit and feel, I take your measurements and build a 3D avatar of your body.',
    img: '/images/process-studio.webp', w: 720, h: 1280, alt: 'The studio: a Kansai sewing machine with thread, tools and fabric around it' },
  { t: 'Pattern', d: 'I draft the pattern from your body, not from a size chart.',
    img: '/images/step-pattern.webp', w: 1400, h: 1400, alt: 'Two pairs laid out waist to waist, leather patches and freehand pocket embroidery on both' },
  { t: 'Fabric', d: 'You pick the cloth. Deadstock denim from Japan and Italy.',
    img: '/images/step-fabric.webp', w: 1050, h: 1400, alt: 'Close-up of black denim: twill weave, white topstitching and freehand embroidery on a back pocket' },
  { t: 'Cut & sew', d: 'I cut and sew everything myself, across 20+ machines.',
    img: '/images/step-sew.webp', w: 1050, h: 1400, alt: 'Black jeans laid flat: a buttoned flap pocket, white topstitching and embroidery' },
  { t: 'Embroidery', d: 'My freehand line on the back pockets. Never the same twice.',
    img: '/images/step-embroidery.webp', w: 1050, h: 1400, alt: 'A back pocket embroidered with a euro sign and a ring of gold stars, leather patch above' },
  { t: 'Fitting', d: 'You try them on in the studio. Repairs on Scottex pieces are free after that.',
    img: '/images/step-fitting.webp', w: 1050, h: 1400, alt: 'A client trying on ecru jeans in the studio, sewing machines and work tables behind' },
];
---
<section id="process" class="relative bg-selvedge py-[clamp(96px,12vw,160px)]" aria-labelledby="process-title" data-process>
  <div class="wrap grid gap-10 md:grid-cols-12 md:grid-rows-[auto_1fr] md:gap-x-6 md:gap-y-0">
    <div class="md:col-span-5">
      <p class="label mb-8 text-ash">02 — Process</p>
      <h2 id="process-title" class="display text-[clamp(34px,3.8vw,60px)]" data-reveal>How I make<br />a pair</h2>
    </div>

    <div class="md:col-span-6 md:col-start-7 md:row-span-2 md:self-center">
      <div class="relative aspect-[5/4] overflow-hidden bg-void md:aspect-auto md:h-[min(74svh,720px)]">
        {steps.map((s, i) => (
          <img id={`proc-img-${i}`} src={s.img} alt={s.alt} width={s.w} height={s.h} loading="lazy"
            class={`proc-img absolute inset-0 h-full w-full object-cover grayscale ${i === 0 ? 'is-on' : ''}`} data-img={i} />
        ))}
      </div>
      <p class="label mt-3 text-right text-ash" aria-hidden="true">[ <span data-proc-now>01</span> / {String(steps.length).padStart(2, '0')} ]</p>
    </div>

    <ol class="border-t border-bone/15 md:col-span-5 md:mt-10 md:self-end" data-reveal>
      {steps.map((s, i) => (
        <li class="border-b border-bone/15">
          <button type="button" class="proc-step group w-full py-3 text-left" data-step={i}
            aria-controls={`proc-img-${i}`} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="flex min-h-8 items-baseline gap-5">
              <span class="label text-ash">[ {String(i + 1).padStart(2, '0')} ]</span>
              <span class="proc-title display text-[clamp(17px,1.5vw,22px)] transition-colors duration-500">{s.t}</span>
            </span>
            <span class="proc-desc grid">
              <span class="overflow-hidden">
                <span class="block max-w-[38ch] pl-[calc(6ch+20px)] pt-2 text-[16px] text-bone/80">{s.d}</span>
              </span>
            </span>
            <span class="proc-bar mt-3 block h-px origin-left bg-bone/70" aria-hidden="true"></span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc-img { opacity: 0; transform: scale(1.06); transition: opacity 0.9s var(--ease-out-expo), transform 1.4s var(--ease-out-expo); }
  .proc-img.is-on { opacity: 1; transform: scale(1); }
  .proc-step .proc-title { color: var(--color-ash); }
  .proc-step:hover .proc-title, .proc-step[aria-pressed='true'] .proc-title { color: var(--color-bone); }
  .proc-desc { grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease-out-expo); }
  .proc-step[aria-pressed='true'] .proc-desc { grid-template-rows: 1fr; }
  .proc-bar { transform: scaleX(0); opacity: 0; }
  .proc-step[aria-pressed='true'] .proc-bar { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .proc-img, .proc-desc { transition: none; transform: none; }
    .proc-bar { display: none; }
  }
</style>

---
// Overview, not a scroll story: all six steps visible at once.
const steps = [
  { t: 'Talk', d: 'We talk fit and feel. I take your measurements and build a 3D avatar of your body.' },
  { t: 'Pattern', d: 'I draft the pattern from your body, not from a size chart.' },
  { t: 'Fabric', d: 'You pick the cloth. Deadstock denim from Japan and Italy, 2.5 to 3 metres a pair.' },
  { t: 'Cut & sew', d: 'I cut and sew everything myself in the studio, across 20+ machines.' },
  { t: 'Embroidery', d: 'My freehand line on the back pockets. Never the same twice.' },
  { t: 'Fitting', d: 'You try them on in the studio. Repairs on Scottex pieces are free after that.' },
];
---
<section id="process" class="relative bg-selvedge py-[clamp(104px,14vw,180px)]" aria-labelledby="process-title">
  <div class="wrap">
    <p class="label mb-10 text-ash">02 — Process</p>
    <h2 id="process-title" class="display text-[clamp(36px,6vw,96px)]" data-reveal>How I make<br />a pair</h2>

    <ol class="mt-16 grid border-t border-bone/15 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((s, i) => (
        <li class="border-b border-bone/15 py-8 sm:pr-8 lg:[&:nth-child(n+4)]:border-b-0" data-reveal>
          <p class="label text-ash">[ {String(i + 1).padStart(2, '0')} ]</p>
          <h3 class="display mt-4 text-[clamp(22px,2.4vw,34px)]">{s.t}</h3>
          <p class="mt-3 max-w-[34ch] text-bone/85">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

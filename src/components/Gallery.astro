---
import { pants } from '../data/pants';
// Swipeable strip of every photo in src/data/pants.ts. Tap a photo to open it full screen.
const slides = pants.flatMap((p) =>
  (p.photos ?? []).map((ph) => ({
    ...ph,
    title: ph.caption ?? (p.no === '—' ? p.label : `${p.label} [ ${p.no} ]`),
    meta: [p.date, p.showCredit ? p.credit : null].filter(Boolean).join(' · '),
  })),
);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="work" class="relative py-[clamp(104px,14vw,180px)]" aria-labelledby="work-title">
  <div class="wrap flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="label mb-10 text-ash">03 — Work</p>
      <h2 id="work-title" class="display text-[clamp(40px,7vw,112px)]" data-reveal>Work</h2>
    </div>
    <div class="flex items-center gap-2" data-reveal>
      <p class="label mr-4 text-ash" aria-live="polite"><span data-gal-now>01</span> / {pad(slides.length)}</p>
      <button type="button" class="label grid min-h-11 min-w-11 place-items-center border border-bone/30 hover:border-bone" data-gal-prev aria-label="Previous photo">←</button>
      <button type="button" class="label grid min-h-11 min-w-11 place-items-center border border-bone/30 hover:border-bone" data-gal-next aria-label="Next photo">→</button>
    </div>
  </div>

  <ul class="gal-track mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto md:gap-6" data-gal data-pswp aria-label="Photos of my work">
    {slides.map((s, i) => (
      <li class="w-[82vw] shrink-0 snap-start md:w-[min(44vw,620px)]" data-gal-slide>
        <a href={s.src} data-pswp-width={s.w} data-pswp-height={s.h} class="group block overflow-hidden"
          aria-label={`Open photo ${i + 1}: ${s.title}`}>
          <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading={i < 2 ? 'eager' : 'lazy'} draggable="false"
            class="aspect-[4/5] w-full object-cover brightness-[0.9] transition duration-700 group-hover:brightness-100" />
        </a>
        <div class="mt-3 flex items-baseline justify-between gap-4 border-t border-bone/15 pt-3">
          <span class="label">{s.title}</span>
          <span class="label text-ash">{s.meta}</span>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .gal-track {
    padding-inline: max(16px, 6vw);
    scroll-padding-inline: max(16px, 6vw);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gal-track::-webkit-scrollbar { display: none; }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const track = document.querySelector<HTMLElement>('[data-gal]');
  if (track) {
    new PhotoSwipeLightbox({ gallery: track, children: 'a', pswpModule: () => import('photoswipe'), bgOpacity: 0.96 }).init();

    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-gal-slide]'));
    const now = document.querySelector('[data-gal-now]');
    const prev = document.querySelector<HTMLButtonElement>('[data-gal-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-gal-next]');
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    const current = () => {
      const left = track.getBoundingClientRect().left + parseFloat(getComputedStyle(track).paddingLeft);
      let best = 0, dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.getBoundingClientRect().left - left);
        if (d < dist) { dist = d; best = i; }
      });
      return best;
    };
    const update = () => {
      const i = current();
      if (now) now.textContent = String(i + 1).padStart(2, '0');
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = atEnd;
    };
    const go = (dir: number) => {
      const i = Math.max(0, Math.min(slides.length - 1, current() + dir));
      track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: smooth });
    };
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style is:global>
  [data-gal-prev]:disabled, [data-gal-next]:disabled { opacity: 0.3; cursor: default; border-color: rgb(232 227 216 / 0.3); }
</style>

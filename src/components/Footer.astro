---
// The one place for practical info: where, when, how to reach him. (The Book section no longer repeats it.)
import { site } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const tel = site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : '';
const social = [
  site.instagram && { href: site.instagram, label: 'Instagram' },
  site.tiktok && { href: site.tiktok, label: 'TikTok' },
  site.email && { href: `mailto:${site.email}`, label: 'Email' },
].filter(Boolean) as { href: string; label: string }[];
const link = 'inline-flex min-h-11 items-center text-white underline-offset-4 hover:text-rivet hover:underline md:inline md:min-h-0';
---
<footer class="relative bg-void">
  <div class="wrap grid gap-12 py-[clamp(48px,6vw,88px)] sm:grid-cols-2 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-4">
      <Logo class="text-bone/90" text="clamp(22px,2.4vw,32px)" img="clamp(40px,3.4vw,52px)" />
    </div>

    <div class="lg:col-span-3">
      <p class="label text-ash">Studio</p>
      <p class="mt-3">{site.address}<br />{site.city}</p>
      <p class="mt-1 text-bone/60">{site.entrance}</p>
    </div>

    <div class="lg:col-span-2">
      <p class="label text-ash">Hours</p>
      <p class="mt-3">{site.hours}</p>
    </div>

    <div class="lg:col-span-3">
      <p class="label text-ash">Contact</p>
      <ul class="mt-1 md:mt-3 md:space-y-1">
        {tel && <li><a class={link} href={tel}>{site.phone}</a></li>}
        {social.map((l) => <li><a class={link} href={l.href} rel="me">{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-bone/10 py-6">
    <p class="label whitespace-nowrap text-ash">© {year} Scottex</p>
    <p class="label whitespace-nowrap text-ash">Custom jeans in Nørrebro</p>
  </div>
</footer>

---
import { site } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const links = [
  site.instagram && { href: site.instagram, label: 'Instagram' },
  site.tiktok && { href: site.tiktok, label: 'TikTok' },
  site.email && { href: `mailto:${site.email}`, label: 'Email' },
].filter(Boolean) as { href: string; label: string }[];
---
<footer class="relative bg-void pt-[clamp(64px,8vw,104px)]">
  <div class="wrap grid place-items-center pb-[clamp(48px,6vw,80px)]">
    <Logo class="mx-auto text-center text-bone/90" text="clamp(22px,2.4vw,32px)" img="clamp(44px,4vw,60px)" />
  </div>
  <div class="wrap flex flex-col gap-6 border-t border-bone/15 py-8 md:flex-row md:items-center md:justify-between">
    <p class="label text-ash">Custom jeans · {site.address} · {site.hours}</p>
    {links.length > 0 && (
      <ul class="label flex gap-6">
        {links.map((l) => <li><a class="font-medium text-white hover:text-rivet" href={l.href} rel="me">{l.label}</a></li>)}
      </ul>
    )}
    <p class="label text-ash">© {year} Scottex</p>
  </div>
</footer>

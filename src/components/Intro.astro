---
// Front fold: sewing machine photo fading to black, the stitched logo, and a split base:
// Benjamin's line in Garamond italic on the left with the booking button under it, the newsletter sign-up bottom right,
// a stitched thread as scroll cue.
import Logo from './Logo.astro';
import { site, bookingTest, offer, offerActive } from '../data/site';
---
<section id="intro" class="intro relative isolate flex h-svh min-h-[620px] flex-col overflow-hidden bg-void" aria-label="Scottex">
  <div class="intro-bg absolute inset-0 -z-10" aria-hidden="true">
    <img src="/images/hero.webp" alt="" width="1199" height="1496" fetchpriority="high"
      class="h-full w-full object-cover object-[50%_30%] grayscale" />
    <div class="intro-scrim absolute inset-0"></div>
  </div>

  <div class="intro-logo absolute left-1/2 top-[24%] -translate-x-1/2 -translate-y-1/2">
    <Logo text="clamp(36px,8vw,64px)" img="clamp(96px,11vw,130px)" eager />
  </div>

  <!-- Scroll cue: a short stitched thread running down (animated in motion.ts) -->
  <svg class="intro-thread absolute bottom-0 left-1/2 hidden h-[14svh] w-px -translate-x-1/2 overflow-visible text-thread lg:block" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true">
    <line x1="1" y1="0" x2="1" y2="100" stroke="currentColor" stroke-width="1.4" stroke-dasharray="6 5" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="intro-body wrap mt-auto grid w-full gap-10 pb-[clamp(40px,8svh,88px)] lg:grid-cols-12 lg:items-end lg:gap-6">
    <div class="flex flex-col items-start gap-4 lg:col-span-7">
      <h1 class="max-w-[14ch] font-serif text-[clamp(38px,5.4vw,84px)] italic leading-[0.98] tracking-[-0.01em]">
        Stitched to<br />your shape.
      </h1>
      <a href="#book" data-book-start class="btn btn-rivet mt-4 w-full justify-between md:mt-6 md:w-[340px]">
        Start your pair <span aria-hidden="true">[ → ]</span>
      </a>
      {offerActive && (
        <p class="label text-rivet" data-offer-until={offer.until}>{offer.text} · until {offer.untilLabel}</p>
      )}
      <p class="label text-ash" data-offer-fallback hidden={offerActive}>{site.address.replace(', st.', '')} · since {site.since}</p>
    </div>

    <!-- Newsletter. With site.newsletter set, the form posts there; otherwise the email goes to the booking-test Google Sheet. -->
    <div class="lg:col-span-4 lg:col-start-9 lg:justify-self-end lg:w-[340px]">
      <form class="intro-news w-full md:max-w-[340px]" action={site.newsletter || undefined} method="post"
        data-news data-sheet={bookingTest.sheetUrl}>
        <label for="intro-email" class="label text-ash">News on new fabrics</label>
        <div class="mt-2 flex h-12 border-b border-bone/40 focus-within:border-bone">
          <input id="intro-email" name="email" type="email" required autocomplete="email" placeholder="your@email.com"
            class="min-w-0 flex-1 bg-transparent text-[16px] text-bone placeholder:text-ash focus:outline-none" />
          <button type="submit" class="label min-w-11 px-2 text-white hover:text-rivet" aria-label="Sign up">[ → ]</button>
        </div>
        <p class="label mt-3 hidden text-bone" data-news-done role="status">Thank you. You're on the list.</p>
      </form>
    </div>
  </div>
</section>

<script>
  // Without a newsletter service, send the email to the booking-test Google Sheet (event "newsletter").
  document.querySelectorAll<HTMLFormElement>('[data-news]').forEach((form) => {
    if (form.getAttribute('action')) return; // a real newsletter service handles it
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
      const email = input.value.trim();
      if (!email) return;
      const sheet = form.dataset.sheet;
      const body = JSON.stringify({ event: 'newsletter', email, visitor: (window as any).scottexVisitor || '', ts: new Date().toISOString(),
        utm_source: new URLSearchParams(location.search).get('utm_source') || '', referrer: document.referrer,
        device: matchMedia('(max-width: 767px)').matches ? 'phone' : 'computer' });
      const local = /^(localhost|127\.|0\.0\.0\.0|\[::1\]|.*\.local$)/.test(location.hostname); // local copies don't record
      if (sheet && !local) {
        try { if (!navigator.sendBeacon(sheet, new Blob([body], { type: 'text/plain;charset=utf-8' }))) throw 0; }
        catch { fetch(sheet, { method: 'POST', mode: 'no-cors', body }).catch(() => {}); }
      } else console.info('[newsletter] (no sheetUrl set)', body);
      form.querySelector('div')!.classList.add('hidden');
      form.querySelector('label')!.classList.add('hidden');
      form.querySelector('[data-news-done]')!.classList.remove('hidden');
    });
  });
</script>

<style>
  /* Dark at the top for the nav, open through the middle, black under the text. */
  .intro-scrim {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.05) 14%, rgb(0 0 0 / 0.2) 34%, rgb(0 0 0 / 0.78) 58%, rgb(0 0 0 / 0.95) 76%, var(--color-void) 100%),
      linear-gradient(90deg, rgb(0 0 0 / 0.6) 0%, transparent 28%, transparent 72%, rgb(0 0 0 / 0.6) 100%);
  }
  :global(.js-motion) .intro-logo, :global(.js-motion) .intro-body > * > * { opacity: 0; }
</style>

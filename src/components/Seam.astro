---
// The thread between sections: continues the dashed scroll cue from the front fold down the page,
// so the sections read as one seam instead of separate blocks. Sewn in on scroll (see motion.ts).
---
<div class="seam relative h-[clamp(64px,9vw,120px)]" aria-hidden="true">
  <span class="seam-line absolute left-1/2 top-0 h-full -translate-x-1/2 border-l-[1.4px] border-dashed border-thread/50"></span>
</div>

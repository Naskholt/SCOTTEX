---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean }
const {
  title = 'SCOTTEX — Custom jeans, made by hand in Nørrebro',
  noindex = false,
  description = 'Custom-fit jeans made by hand by Benjamin in Nørrebro, Copenhagen. Japanese and Italian surplus denim, free-hand embroidery, free repairs. Start your pair with a fitting in the studio.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'Scottex',
  description,
  url: canonical.href,
  address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'København N', postalCode: '2200', addressCountry: 'DK' },
  openingHours: 'Mo-Fr 10:00-17:00',
  ...(site.phone && { telephone: site.phone.replace(/\s/g, '') }),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark only" />
    <!-- Already dark: ask dark-mode extensions (Dark Reader etc.) not to re-colour the site -->
    <meta name="darkreader-lock" />
    <meta name="theme-color" content="#0b0b0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
  </head>
  <body id="top">
    <a href="#main" class="label sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:bg-bone focus:p-3 focus:text-void">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/motion';
    </script>
    <script is:inline>
      // Christmas offer (src/data/site.ts → offer): remove it after its last day, even without a new deploy.
      (function () {
        var el = document.querySelector('[data-offer-until]');
        if (!el || new Date() <= new Date(el.getAttribute('data-offer-until') + 'T23:59:59')) return;
        document.querySelectorAll('[data-offer-until]').forEach(function (e) { e.remove(); });
        document.querySelectorAll('[data-offer-fallback]').forEach(function (e) { e.hidden = false; });
      })();
    </script>
  </body>
</html>
